# Gmail hesabiniz
GMAIL_ADDRESS=ornek@gmail.com
# Google Hesabi > Guvenlik > Uygulama sifreleri ile olusturulan 16 haneli sifre
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Ozetin gonderilecegi adres (bos birakilirsa GMAIL_ADDRESS kullanilir)
DIGEST_TO=

# Google AI Studio (https://aistudio.google.com/apikey) uzerinden alinir
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Kac saatlik e-postalari tarayacagi
LOOKBACK_HOURS=24

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# IMAP baglantisi koparsa kac kez yeniden denenecek
IMAP_RETRIES=3
# Tek bir IMAP islemi icin saniye cinsinden zaman asimi
IMAP_TIMEOUT=60
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_FOLDER=INBOX
